{
  "name": "swim-basi-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/sanity/validate-production.mjs --build-gate && node scripts/verify-homepage-visual-parity.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images:brand": "node scripts/optimize-brand-images.mjs",
    "images:products": "node scripts/optimize-product-images.mjs",
    "security:scan": "node scripts/security/scan-release-secrets.mjs",
    "verify": "node scripts/verify-build.mjs",
    "verify:homepage": "node scripts/verify-homepage-visual-parity.mjs",
    "verify:homepage-media": "node scripts/validate-homepage-media.mjs",
    "sanity:inventory": "node scripts/sanity/inventory-media.mjs",
    "sanity:migrate:dry-run": "node scripts/sanity/migrate-all.mjs --dry-run",
    "sanity:migrate:verify": "node scripts/sanity/verify-migration.mjs",
    "sanity:validate:pre-publish": "node scripts/sanity/validate-production.mjs --pre-publish",
    "sanity:audit:production": "node scripts/sanity/audit-production-state.mjs",
    "sanity:cleanup-private-ids:dry-run": "node scripts/sanity/cleanup-private-ids.mjs --dry-run",
    "sanity:cleanup-private-ids": "node scripts/sanity/cleanup-private-ids.mjs --apply",
    "sanity:validate:production": "node scripts/sanity/validate-production.mjs --published",
    "sanity:validate:live": "node scripts/sanity/validate-live-storefront.mjs",
    "sanity:publish:dry-run": "node scripts/sanity/publish-production.mjs --dry-run",
    "sanity:publish": "node scripts/sanity/publish-production.mjs --apply",
    "sanity:test-page-builder": "node scripts/sanity/test-page-builder.mjs"
  },
  "dependencies": {
    "@sanity/astro": "3.5.0",
    "@sanity/client": "7.25.0",
    "@sanity/image-url": "2.1.1",
    "astro": "7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "eslint": "9.39.2",
    "eslint-plugin-astro": "1.3.1",
    "prettier": "3.8.2",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "^0.35.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
