---
import type { ManagedImage } from '../lib/sanity/types';
import { getImageDimensions, urlForSanityImage } from '../lib/sanity/image';

interface Props {
  value: ManagedImage;
  sizes?: string;
  class?: string;
  priority?: boolean;
}

const {
  value,
  sizes = '(max-width: 760px) 100vw, 1200px',
  class: className,
  priority = value.loading === 'eager',
} = Astro.props;

if (!value.image) throw new Error('SanityImage requires an image asset.');
const source = value.image;
const mobile = value.mobileImage;
const dimensions = getImageDimensions(source);
const widths = [480, 640, 800, 960, 1200, 1600];
const src = urlForSanityImage(source).width(1200).fit('max').auto('format').quality(85).url();
const srcset = widths
  .map(
    (width) =>
      `${urlForSanityImage(source).width(width).fit('max').auto('format').quality(85).url()} ${width}w`,
  )
  .join(', ');
const mobileSrcset = mobile
  ? widths
      .slice(0, 4)
      .map(
        (width) =>
          `${urlForSanityImage(mobile).width(width).fit('max').auto('format').quality(82).url()} ${width}w`,
      )
      .join(', ')
  : undefined;
---

<picture>
  {mobileSrcset && <source media="(max-width: 640px)" srcset={mobileSrcset} sizes="100vw" />}
  <img
    class={className}
    src={src}
    srcset={srcset}
    sizes={sizes}
    width={dimensions.width}
    height={dimensions.height}
    alt={value.decorative ? '' : value.alt || ''}
    aria-hidden={value.decorative ? 'true' : undefined}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
</picture>
