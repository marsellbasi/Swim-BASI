---
import type { PageSection, SanityCollection } from "../lib/sanity/types";
import {
  portableTextToPlainText,
  sanityProductToLocal,
} from "../lib/sanity/adapters";
import Breadcrumbs from "./Breadcrumbs.astro";
import ProductGrid from "./ProductGrid.astro";
import ExternalCheckoutNotice from "./ExternalCheckoutNotice.astro";
import "../styles/commerce.css";

interface Props {
  collection: SanityCollection;
  collections: SanityCollection[];
}

const { collection, collections } = Astro.props;
const sections = (collection.sections || []).filter(
  (section) => section.enabled !== false,
);
const intro = sections.find((section) => section._type === "richTextSection");
const catalog = sections.find(
  (section) => section._type === "productGridSection",
);
const bodyText = (section?: PageSection) =>
  section
    ? typeof section.body === "string"
      ? section.body
      : portableTextToPlainText(section.body || section.content)
    : "";
const sanityProducts = catalog?.products || collection.products || [];
const products = sanityProducts.map(sanityProductToLocal);
const uniformCategory = products.every(
  (product) => product.collection === collection.title,
);
const prices = [
  ...new Set(
    sanityProducts
      .map((product) => product.displayPrice)
      .filter(
        (price): price is number => typeof price === "number" && price > 0,
      ),
  ),
];
const title = intro?.heading || collection.title;
const description = bodyText(intro);
const fixedPrice = prices.length === 1 ? prices[0] : undefined;
const formattedPrice =
  fixedPrice !== undefined
    ? new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
      }).format(fixedPrice)
    : "";

if (
  !collection.slug ||
  !title ||
  !intro?.eyebrow ||
  !description ||
  !formattedPrice ||
  products.length === 0
) {
  throw new Error(
    `The published Sanity collection ${collection.slug || collection._id || "document"} requires an eyebrow, title, description, one fixed product price, and products.`,
  );
}
---

<div
  class:list={[
    "collection-page",
    { "collection-page--single-category": uniformCategory },
  ]}
>
  <section class="collection-catalog" aria-labelledby="collection-title">
    <div class="wrap">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Collections", href: "/collections" },
          { label: title },
        ]}
      />

      <header class="collection-intro">
        <p class="eyebrow">{intro.eyebrow}</p>
        <h1 id="collection-title">{title}</h1>
        <p class="collection-intro__description">{description}</p>
        <p class="collection-intro__price">
          <span>{products.length} styles</span><span>{formattedPrice}</span>
        </p>
      </header>
      <nav class="collection-category-nav" aria-label="Shop by silhouette">
        <a href="/shop">All Products</a>
        {
          collections
            .filter((item) => item.slug && item.title)
            .map((item) => (
              <a
                href={`/collections/${item.slug}`}
                aria-current={
                  item.slug === collection.slug ? "page" : undefined
                }
              >
                {item.title}
              </a>
            ))
        }
      </nav>
      <h2 class="collection-products-title">{catalog?.heading || title}</h2>
      <ProductGrid products={products} />
      <ExternalCheckoutNotice />
    </div>
  </section>
</div>

<style>
  .collection-catalog {
    padding: var(--collection-space) 0;
  }

  .collection-page {
    --collection-space: clamp(28px, 2.5vw, 40px);
  }

  .collection-catalog :global(.breadcrumbs) {
    padding-top: 0;
  }

  .collection-intro {
    margin-top: 20px;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    column-gap: clamp(32px, 5vw, 72px);
    align-items: end;
  }

  .collection-intro .eyebrow {
    margin: 0;
  }

  .collection-intro h1 {
    grid-column: 1;
    margin: 12px 0 0;
    font-family: var(--serif);
    font-size: clamp(3rem, 4.5vw, 5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .collection-intro__description {
    grid-column: 2;
    grid-row: 1 / 4;
    max-width: 460px;
    margin: 0;
    color: #4c4c4c;
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.65;
  }

  .collection-intro__price {
    grid-column: 1;
    margin: 12px 0 0;
    display: flex;
    gap: 16px;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .collection-catalog :global(.product-grid) {
    margin-top: 24px;
  }

  .collection-page--single-category :global(.product-category) {
    display: none;
  }

  .collection-category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin-top: 16px;
  }

  .collection-category-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: var(--gold);
  }

  .collection-category-nav a[aria-current="page"] {
    font-weight: 700;
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }

  .collection-products-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .collection-catalog {
      padding-block: var(--collection-space);
    }

    .collection-intro {
      margin-top: 18px;
      display: block;
    }

    .collection-intro__description {
      max-width: 680px;
      margin-top: 14px;
    }

    .collection-intro h1 {
      font-size: clamp(3rem, 13vw, 4.5rem);
    }
  }

  @media (max-width: 720px) {
    .collection-category-nav {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
    .collection-category-nav a {
      letter-spacing: 0.03em;
      line-height: 1.5;
    }
  }
</style>
