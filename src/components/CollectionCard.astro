---
import type { Product } from "../data/products";
import type { ManagedImage } from "../lib/sanity/types";
import SanityImage from "./SanityImage.astro";

interface Props {
  title: string;
  href: string;
  price: string;
  color: string;
  index: string;
  product?: Product;
  managedImage?: ManagedImage;
  diagnosticKey?: string;
}
const {
  title,
  href,
  price,
  color,
  index,
  product,
  managedImage,
  diagnosticKey,
} = Astro.props;
const hasImage = Boolean(product?.image || managedImage?.image);
---

<article class="collection-card">
  <a href={href} aria-label={`Shop ${title}`}>
    <div
      class:list={["collection-art", { "collection-art--product": hasImage }]}
      style={`--collection-color:${color}`}
    >
      {
        managedImage?.image ? (
          <SanityImage
            value={managedImage}
            pictureClass="collection-picture"
            aspectRatio={1}
            sizes="(max-width: 720px) calc(100vw - 24px), (max-width: 1440px) 33vw, 470px"
            diagnosticKey={diagnosticKey}
          />
        ) : product?.image ? (
          <img
            src={product.image.src}
            width={product.image.width}
            height={product.image.height}
            alt={product.image.alt}
            loading="lazy"
            decoding="async"
          />
        ) : null
      }<span>{index}</span>
    </div>
    <div class="collection-copy">
      <div><h3>{title}</h3><p>{price}</p></div><span
        class="circle-arrow"
        aria-hidden="true">→</span
      >
    </div>
  </a>
</article>
