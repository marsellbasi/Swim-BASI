---
import type { ResolvedSeo } from '../lib/sanity/seo';

interface Props {
  seo: ResolvedSeo;
  type?: 'website' | 'product';
}
const { seo, type = 'website' } = Astro.props;
const canonical = seo.canonicalUrl
  ? new URL(seo.canonicalUrl)
  : new URL(seo.canonicalPath, Astro.site ?? 'https://swimbasi.com');
const imageUrl = seo.image ? new URL(seo.image, Astro.site ?? 'https://swimbasi.com') : undefined;
const twitterImage = seo.twitterImage
  ? new URL(seo.twitterImage, Astro.site ?? 'https://swimbasi.com')
  : imageUrl;
const robots = [seo.noIndex ? 'noindex' : 'index', seo.noFollow ? 'nofollow' : 'follow'].join(', ');
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Swim BASI" />
<meta property="og:title" content={seo.openGraphTitle} />
<meta property="og:description" content={seo.openGraphDescription} />
<meta property="og:url" content={canonical} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta name="twitter:card" content={seo.cardType} />
<meta name="twitter:title" content={seo.twitterTitle} />
<meta name="twitter:description" content={seo.twitterDescription} />
{twitterImage && <meta name="twitter:image" content={twitterImage} />}
