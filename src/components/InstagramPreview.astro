---
const tiles = [
  { color: '#F16A8D', name: 'Brink Pink' },
  { color: '#111111', name: 'Black' },
  { color: '#E8692A', name: 'Orange' },
  { color: '#247BA0', name: 'Eastern Blue' },
];
---

<section class="instagram-section wrap" aria-labelledby="instagram-title">
  <div class="instagram-heading">
    <div>
      <p class="eyebrow">@swimbasi</p><h2 id="instagram-title">Follow the color story.</h2>
    </div><a href="https://instagram.com/swimbasi" target="_blank" rel="noopener noreferrer"
      >View Instagram <span aria-hidden="true">↗</span></a
    >
  </div>
  <div class="instagram-grid">
    {
      tiles.map((tile, i) => (
        <div
          class="instagram-tile"
          style={`--tile:${tile.color}`}
          role="img"
          aria-label={`Swim BASI color-story preview ${i + 1} in ${tile.name}`}
        >
          <span>BASI / 0{i + 1}</span>
        </div>
      ))
    }
  </div>
</section>
