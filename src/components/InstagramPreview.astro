---
import ResponsiveBrandImage from './ResponsiveBrandImage.astro';
import { getBrandImage } from '../data/brand-images';

const tiles = [
  {
    image: getBrandImage('red-string-bikini-studio-detail'),
    label: 'Swim BASI red string-bikini campaign detail',
  },
  {
    image: getBrandImage('forest-green-string-bikini-studio-portrait'),
    label: 'Swim BASI green string-bikini studio portrait',
  },
  {
    image: getBrandImage('eastern-blue-string-bikini-poolside-back'),
    label: 'Swim BASI blue string-bikini poolside view',
  },
  {
    image: getBrandImage('lavender-string-bikini-poolside-back'),
    label: 'Swim BASI lavender string-bikini poolside portrait',
  },
];
---

<section class="instagram-section wrap" aria-labelledby="instagram-title">
  <div class="instagram-heading">
    <div>
      <p class="eyebrow">@swimbasi</p><h2 id="instagram-title">Follow the color story.</h2>
    </div><a href="https://instagram.com/swimbasi" target="_blank" rel="noopener noreferrer"
      >View Instagram <span aria-hidden="true">↗</span></a
    >
  </div>
  <div class="instagram-grid">
    {
      tiles.map((tile) => (
        <a
          class="instagram-tile"
          href="https://instagram.com/swimbasi"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Explore the Swim BASI Instagram profile — ${tile.label} (opens in a new tab)`}
        >
          <ResponsiveBrandImage
            image={tile.image}
            alt={tile.label}
            sizes="(max-width: 720px) calc(50vw - 17px), (max-width: 1440px) calc(25vw - 18px), 350px"
          />
        </a>
      ))
    }
  </div>
</section>
