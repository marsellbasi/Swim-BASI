---
import Logo from './Logo.astro';
import MobileNavigation from './MobileNavigation.astro';
import type { NavigationItem } from '../lib/sanity/types';

interface Props {
  items?: NavigationItem[] | null;
}
const { items } = Astro.props;
const defaults: NavigationItem[] = [
  { label: 'Shop', destination: { linkType: 'internal', internalPath: '/shop' } },
  { label: 'Collections', destination: { linkType: 'internal', internalPath: '/collections' } },
  { label: 'About', destination: { linkType: 'internal', internalPath: '/about' } },
  { label: 'Size Guide', destination: { linkType: 'internal', internalPath: '/size-guide' } },
];
const navigation = items?.length ? items : defaults;
const hrefFor = (item: NavigationItem) =>
  item.destination?.linkType === 'external'
    ? item.destination.externalUrl
    : item.destination?.internalPath;
---

<header class="site-header">
  <div class="header-inner wrap">
    <Logo />
    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navigation.map(
          (item) =>
            hrefFor(item) && (
              <a
                href={hrefFor(item)}
                target={item.destination?.openInNewTab ? '_blank' : undefined}
                rel={item.destination?.openInNewTab ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            ),
        )
      }
    </nav>
    <a
      class="instagram-link"
      href="https://instagram.com/swimbasi"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Follow Swim BASI on Instagram (opens in a new tab)"
      >Instagram <span aria-hidden="true">↗</span></a
    >
    <MobileNavigation items={navigation} />
  </div>
</header>
