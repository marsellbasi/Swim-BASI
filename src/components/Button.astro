---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  label?: string;
}
const { href, variant = 'primary', external = false, label } = Astro.props;
---

<a
  class:list={['button', `button--${variant}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  aria-label={label}
>
  <slot />{external && <span aria-hidden="true"> ↗</span>}
</a>
