---
import type { Product } from '../data/products';
import Price from './Price.astro';
interface Props {
  product: Product;
}
const { product } = Astro.props;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  color: product.colorName,
  image: product.image?.src,
  url: product.printfulUrl,
  offers: {
    '@type': 'Offer',
    priceCurrency: product.currency,
    price: product.price.toFixed(2),
    url: product.printfulUrl,
    // Inventory is intentionally omitted until availability is confirmed.
  },
};
---

<article class="product-card" data-product-id={product.id} data-product-slug={product.slug}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <a
    class="product-visual"
    href={product.printfulUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`View ${product.name} on Printful (opens in a new tab)`}
    style={`--product-color:${product.colorHex}`}
  >
    {
      product.image ? (
        <>
          <img
            class="product-image product-image--primary"
            src={product.image.src}
            width={product.image.width}
            height={product.image.height}
            alt={product.image.alt}
            loading="lazy"
            decoding="async"
          />
          {product.hoverImage && (
            <img
              class="product-image product-image--hover"
              width={product.hoverImage.width}
              height={product.hoverImage.height}
              alt=""
              aria-hidden="true"
              data-hover-src={product.hoverImage.src}
              loading="lazy"
              decoding="async"
            />
          )}
        </>
      ) : (
        <div
          class="product-placeholder"
          role="img"
          aria-label={`${product.name} color preview in ${product.colorName}; product photography is not shown`}
        >
          <span class="placeholder-label">Color preview</span>
        </div>
      )
    }
    <span class="color-chip">{product.colorName}</span>
  </a>
  <div class="product-info">
    <p class="product-category">{product.collection}</p><h3>
      <a href={product.printfulUrl} target="_blank" rel="noopener noreferrer">{product.name}</a>
    </h3>
    <div class="product-meta">
      <Price amount={product.price} currency={product.currency} />
    </div>
    <a
      class="product-cta"
      href={product.printfulUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View ${product.name} on Printful (opens in a new tab)`}
      >View Product <span aria-hidden="true">↗</span></a
    >
  </div>
</article>

<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('.product-visual').forEach((visual) => {
    const hoverImage = visual.querySelector<HTMLImageElement>('[data-hover-src]');
    if (!hoverImage) return;

    const loadHoverImage = () => {
      if (hoverImage.src) return;
      const source = hoverImage.dataset.hoverSrc;
      if (!source) return;
      hoverImage.addEventListener('load', () => hoverImage.classList.add('is-loaded'), {
        once: true,
      });
      hoverImage.src = source;
    };

    if (finePointer.matches) {
      visual.addEventListener('pointerenter', loadHoverImage, { once: true });
      visual.addEventListener('focus', loadHoverImage, { once: true });
    }
  });
</script>
