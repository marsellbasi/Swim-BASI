---
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import SkipLink from '../components/SkipLink.astro';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}
const { title, description, canonicalPath } = Astro.props;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Swim BASI',
  url: 'https://swimbasi.com',
  sameAs: ['https://instagram.com/swimbasi'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta
      name="theme-color"
      content="#ffffff"
    />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <SEO title={title} description={description} canonicalPath={canonicalPath} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body
    ><SkipLink /><AnnouncementBar /><Header /><main id="main-content" tabindex="-1">
      <slot />
    </main><Footer /></body>
</html>
