---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionEditorial from '../../components/CollectionEditorial.astro';
import { getSanityCollections, getSiteSettings } from '../../lib/sanity/content';
import { SANITY_CONTENT_ENABLED } from '../../lib/sanity/config';
import { resolveSeo } from '../../lib/sanity/seo';

const sanityCollection = (await getSanityCollections())?.find(
  (item) => item.slug === 'string-bikinis',
);
if (SANITY_CONTENT_ENABLED && !sanityCollection) {
  throw new Error('The published Sanity String Bikini collection is required for production.');
}
const settings = await getSiteSettings();
const pageSeo = resolveSeo({
  page: sanityCollection?.seo,
  settings,
  derivedTitle: 'String Bikinis | Swim BASI',
  derivedDescription: 'Shop Swim BASI string bikinis in confident colorways for $37.99.',
  canonicalPath: '/collections/string-bikinis',
});
---

<BaseLayout
  title="String Bikinis | Swim BASI"
  description="Shop Swim BASI string bikinis in confident colorways for $37.99."
  seo={pageSeo}
>
  {sanityCollection && <CollectionEditorial collection={sanityCollection} />}
</BaseLayout
>
