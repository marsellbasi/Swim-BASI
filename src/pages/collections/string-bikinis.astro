---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { products } from '../../data/products';
import { filterByCategory } from '../../utils/products';
---

<BaseLayout
  title="String Bikinis | Swim BASI"
  description="Shop Swim BASI string bikinis in confident colorways, starting at $37.99."
  ><section class="page-hero">
    <div class="wrap">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Collections', href: '/collections' },
          { label: 'String Bikinis' },
        ]}
      /><p class="eyebrow">Starting at $37.99</p><h1>String Bikinis</h1><p class="lead">
        A minimal silhouette with maximum confidence.
      </p>
    </div>
  </section><section class="section wrap">
    <ProductGrid products={filterByCategory(products, 'string-bikinis')} />
  </section></BaseLayout
>
