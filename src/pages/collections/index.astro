---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CollectionsEditorial from "../../components/CollectionsEditorial.astro";
import { getSanityPage, getSiteSettings } from "../../lib/sanity/content";
import { SANITY_CONTENT_ENABLED } from "../../lib/sanity/config";
import { resolveSeo } from "../../lib/sanity/seo";

const sanityPage = await getSanityPage("collectionsPage");
if (SANITY_CONTENT_ENABLED && !sanityPage) {
  throw new Error(
    "The published Sanity Collections page is required for the production build.",
  );
}
const settings = await getSiteSettings();
const pageSeo = resolveSeo({
  page: sanityPage?.seo,
  settings,
  derivedTitle: "Swimwear Collections | Swim BASI",
  derivedDescription:
    "Explore Swim BASI one-piece, string bikini, and high-waisted bikini collections.",
  canonicalPath: "/collections",
});
---

<BaseLayout
  title="Swimwear Collections | Swim BASI"
  description="Explore Swim BASI one-piece, string bikini, and high-waisted bikini collections."
  seo={pageSeo}
>
  {sanityPage && <CollectionsEditorial page={sanityPage} />}
</BaseLayout>
