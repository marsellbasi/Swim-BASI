---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionEditorial from '../../components/CollectionEditorial.astro';
import { getSanityCollections, getSiteSettings } from '../../lib/sanity/content';
import { SANITY_CONTENT_ENABLED } from '../../lib/sanity/config';
import { resolveSeo } from '../../lib/sanity/seo';

const sanityCollection = (await getSanityCollections())?.find((item) => item.slug === 'one-piece');
if (SANITY_CONTENT_ENABLED && !sanityCollection) {
  throw new Error('The published Sanity One-Piece collection is required for production.');
}
const settings = await getSiteSettings();
const pageSeo = resolveSeo({
  page: sanityCollection?.seo,
  settings,
  derivedTitle: 'One-Piece Swimwear | Swim BASI',
  derivedDescription:
    'Shop Swim BASI one-piece swimsuits in bold, expressive colorways for $32.99.',
  canonicalPath: '/collections/one-piece',
});
---

<BaseLayout
  title="One-Piece Swimwear | Swim BASI"
  description="Shop Swim BASI one-piece swimsuits in bold, expressive colorways for $32.99."
  seo={pageSeo}
>
  {sanityCollection && <CollectionEditorial collection={sanityCollection} />}
</BaseLayout
>
