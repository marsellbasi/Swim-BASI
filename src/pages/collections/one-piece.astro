---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { products } from '../../data/products';
import { filterByCategory } from '../../utils/products';
import PageSections from '../../components/PageSections.astro';
import { getSanityCollections, getSiteSettings } from '../../lib/sanity/content';
import { resolveSeo } from '../../lib/sanity/seo';

const sanityCollection = (await getSanityCollections())?.find((item) => item.slug === 'one-piece');
const settings = await getSiteSettings();
const pageSeo = resolveSeo({
  page: sanityCollection?.seo,
  settings,
  derivedTitle: 'One-Piece Swimwear | Swim BASI',
  derivedDescription:
    'Shop Swim BASI one-piece swimsuits in bold, expressive colorways for $32.99.',
  canonicalPath: '/collections/one-piece',
});
---

<BaseLayout
  title="One-Piece Swimwear | Swim BASI"
  description="Shop Swim BASI one-piece swimsuits in bold, expressive colorways for $32.99."
  seo={pageSeo}
  >{
    sanityCollection?.sections?.length ? (
      <PageSections sections={sanityCollection.sections} />
    ) : (
      <>
        <>
          <section class="page-hero">
            <div class="wrap">
              <>
                <Breadcrumbs
                  items={[
                    { label: 'Home', href: '/' },
                    { label: 'Collections', href: '/collections' },
                    { label: 'One-Piece' },
                  ]}
                />
                <p class="eyebrow">$32.99</p>
                <h1>One-Piece Swimwear</h1>
                <p class="lead">Clean lines, bold color, and a silhouette built for presence.</p>
              </>
            </div>
          </section>
          <section class="section wrap">
            <ProductGrid products={filterByCategory(products, 'one-piece')} />
          </section>
        </>
      </>
    )
  }</BaseLayout
>
