---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Shipping & Returns | Swim BASI"
  description="Shipping and returns information for Swim BASI orders completed through Printful."
  ><section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Shipping & Returns' }]} /><p
        class="eyebrow"
      >
        Customer care
      </p><h1>Shipping & Returns</h1>
    </div>
  </section><section class="content-page wrap">
    <div class="notice">
      <strong>Policy update:</strong> This policy is being finalized before the official Swim BASI launch.
    </div><article class="prose">
      <h2>Order fulfillment</h2><p>
        Purchases are currently completed and fulfilled through Printful. Available production
        timelines, shipping methods, destinations, and costs are shown during Printful checkout.
      </p><h2>Returns and exchanges</h2><p>
        Return and exchange guidance is being finalized. Please review the information shown by
        Printful before completing your order.
      </p><h2>Order support</h2><p>
        Customer-care details will be published here before the official Swim BASI launch.
      </p>
    </article>
  </section></BaseLayout
>
