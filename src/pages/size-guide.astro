---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Swimwear Size Guide | Swim BASI"
  description="Read the preliminary Swim BASI sizing guidance and verify final product measurements with Printful before ordering."
  ><section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Size Guide' }]} /><p
        class="eyebrow"
      >
        Fit notes
      </p><h1>Size guide</h1><p class="lead">
        The right fit starts with product-specific measurements.
      </p>
    </div>
  </section><section class="content-page wrap">
    <div class="notice">
      <strong>Pre-launch requirement:</strong> Final sizing information must be verified against the exact
      Printful product specifications before this page is published as definitive guidance.
    </div><div class="info-grid">
      <article class="info-card">
        <h2>Measure with care</h2><p>
          Use a flexible measuring tape and keep it level. Measure bust, natural waist, and the
          fullest part of your hips.
        </p>
      </article><article class="info-card">
        <h2>Check the product page</h2><p>
          Fabric, stretch, and cut can affect fit. Always review the latest product-specific sizing
          information at Printful before ordering.
        </p>
      </article>
    </div>
  </section></BaseLayout
>
