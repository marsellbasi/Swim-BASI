---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageSections from '../components/PageSections.astro';
import { getSanityPage, getSiteSettings } from '../lib/sanity/content';
import { resolveSeo } from '../lib/sanity/seo';

const sanityPage = await getSanityPage('sizeGuide');
const settings = await getSiteSettings();
const pageSeo = resolveSeo({
  page: sanityPage?.seo,
  settings,
  derivedTitle: 'Swimwear Size Guide | Swim BASI',
  derivedDescription:
    'Find Swim BASI fit notes and product-specific sizing guidance before ordering through Printful.',
  canonicalPath: '/size-guide',
});
---

<BaseLayout
  title="Swimwear Size Guide | Swim BASI"
  description="Find Swim BASI fit notes and product-specific sizing guidance before ordering through Printful."
  seo={pageSeo}
  >{
    sanityPage ? (
      <PageSections sections={sanityPage.sections || []} page={sanityPage} />
    ) : (
      <>
        <>
          <section class="page-hero">
            <div class="wrap">
              <>
                <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Size Guide' }]} />
                <p class="eyebrow">Fit notes</p>
                <h1>Size guide</h1>
                <p class="lead">The right fit starts with product-specific measurements.</p>
              </>
            </div>
          </section>
          <section class="content-page wrap">
            <>
              <div class="notice">
                <strong>Sizing update:</strong> Detailed Swim BASI sizing guidance is being
                finalized. Until then, review the sizing information on each Printful product page
                before ordering.
              </div>
              <div class="info-grid">
                <>
                  <article class="info-card">
                    <>
                      <h2>Measure with care</h2>
                      <p>
                        Use a flexible measuring tape and keep it level. Measure bust, natural
                        waist, and the fullest part of your hips.
                      </p>
                    </>
                  </article>
                  <article class="info-card">
                    <>
                      <h2>Check the product page</h2>
                      <p>
                        Fabric, stretch, and cut can affect fit. Always review the latest
                        product-specific sizing information at Printful before ordering.
                      </p>
                    </>
                  </article>
                </>
              </div>
            </>
          </section>
        </>
      </>
    )
  }</BaseLayout
>
