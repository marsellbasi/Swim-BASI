---
import BaseLayout from '../layouts/BaseLayout.astro';
import SizeGuideEditorial from '../components/SizeGuideEditorial.astro';
import { getSanityPage, getSiteSettings } from '../lib/sanity/content';
import { SANITY_CONTENT_ENABLED } from '../lib/sanity/config';
import { resolveSeo } from '../lib/sanity/seo';

const sanityPage = await getSanityPage('sizeGuide');
if (SANITY_CONTENT_ENABLED && !sanityPage) {
  throw new Error('Published Sanity Size Guide content is required in production.');
}
const settings = await getSiteSettings();
const pageSeo = resolveSeo({
  page: sanityPage?.seo,
  settings,
  derivedTitle: 'Size Guide | Swimwear Fit & Measurements',
  derivedDescription:
    'Find your Swim BASI fit with measuring guidance, silhouette-specific fit notes, and product sizing information for one-piece, string bikini, and high-waisted swimwear.',
  canonicalPath: '/size-guide',
});
---

<BaseLayout
  title="Size Guide | Swimwear Fit & Measurements"
  description="Find your Swim BASI fit with measuring guidance, silhouette-specific fit notes, and product sizing information for one-piece, string bikini, and high-waisted swimwear."
  seo={pageSeo}
>
  {sanityPage && <SizeGuideEditorial page={sanityPage} />}
</BaseLayout>
