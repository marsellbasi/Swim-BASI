---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Contact Swim BASI"
  description="Contact Swim BASI with product, collaboration, or general questions."
  ><section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} /><p
        class="eyebrow"
      >
        Get in touch
      </p><h1>We’d love to hear from you.</h1>
    </div>
  </section><section class="content-page wrap contact-layout">
    <div class="prose">
      <p>
        This presentation form is not connected yet. For now, connect with Swim BASI on <a
          href="https://instagram.com/swimbasi"
          target="_blank"
          rel="noopener noreferrer"><u>Instagram</u> ↗</a
        >.
      </p><p class="notice">
        TODO: Add the approved customer service email address or connect a static-form provider
        before launch.
      </p>
    </div><form class="contact-form" data-contact-form>
      <label for="name">Name<input id="name" name="name" autocomplete="name" required /></label
      ><label for="email"
        >Email<input id="email" name="email" type="email" autocomplete="email" required /></label
      ><label for="message"
        >Message<textarea id="message" name="message" rows="6" required></textarea></label
      ><button type="submit">Prepare message</button><p class="form-status" aria-live="polite">
        This form is presentation-only and does not send or store information.
      </p>
    </form>
  </section><script>
    document
      .querySelector<HTMLFormElement>('[data-contact-form]')
      ?.addEventListener('submit', (event) => event.preventDefault());
  </script></BaseLayout
>
