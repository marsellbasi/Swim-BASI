---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Contact Swim BASI"
  description="Find current ways to connect with Swim BASI for collection news and brand updates."
  ><section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} /><p
        class="eyebrow"
      >
        Get in touch
      </p><h1>We’d love to hear from you.</h1>
    </div>
  </section><section class="content-page wrap contact-layout">
    <div class="prose">
      <p>
        Swim BASI customer care is getting ready to welcome your questions. In the meantime, follow
        the color story on <a
          href="https://instagram.com/swimbasi"
          target="_blank"
          rel="noopener noreferrer"><u>Instagram</u> ↗</a
        >.
      </p>
    </div><aside class="info-card" aria-labelledby="contact-update-title">
      <h2 id="contact-update-title">Customer care</h2><p>
        Support contact details will be shared here before the official Swim BASI launch.
      </p>
    </aside>
  </section></BaseLayout
>
