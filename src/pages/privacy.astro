---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Privacy Policy | Swim BASI"
  description="Privacy information for the Swim BASI website and its Printful checkout experience."
  ><section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Privacy' }]} /><p
        class="eyebrow"
      >
        Legal
      </p><h1>Privacy Policy</h1>
    </div>
  </section><section class="content-page wrap">
    <div class="notice">
      <strong>Policy update:</strong> This privacy policy is being finalized before the official Swim
      BASI launch and will be reviewed before it becomes effective.
    </div><article class="prose">
      <h2>Information collection</h2><p>
        Swim BASI does not currently offer customer accounts or direct checkout on swimbasi.com. If
        site services change, this policy will be updated to explain how information is handled.
      </p><h2>Third-party checkout</h2><p>
        Product links direct visitors to Printful, whose privacy practices apply on its storefront
        and checkout pages.
      </p><h2>Contact</h2><p>
        Privacy contact details and the effective date will be published when this policy is
        finalized.
      </p>
    </article>
  </section></BaseLayout
>
