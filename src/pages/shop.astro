---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopEditorial from '../components/ShopEditorial.astro';
import { getSanityPage, getSiteSettings } from '../lib/sanity/content';
import { SANITY_CONTENT_ENABLED } from '../lib/sanity/config';
import { resolveSeo } from '../lib/sanity/seo';

const sanityPage = await getSanityPage('shopPage');
if (SANITY_CONTENT_ENABLED && !sanityPage) {
  throw new Error('The published Sanity Shop page is required for the production build.');
}
const settings = await getSiteSettings();
const pageSeo = resolveSeo({
  page: sanityPage?.seo,
  settings,
  derivedTitle: 'Shop All Swimwear | Swim BASI',
  derivedDescription:
    'Explore the complete Swim BASI catalog of one-piece swimwear, string bikinis, and high-waisted bikinis.',
  canonicalPath: '/shop',
});
---

<BaseLayout
  title="Shop All Swimwear | Swim BASI"
  description="Explore the complete Swim BASI catalog of one-piece swimwear, string bikinis, and high-waisted bikinis."
  seo={pageSeo}
>
  {sanityPage && <ShopEditorial page={sanityPage} />}
</BaseLayout
>
