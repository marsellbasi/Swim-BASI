---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Terms of Use | Swim BASI"
  description="Terms information for using the Swim BASI website and visiting its Printful checkout."
  ><section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Terms' }]} /><p class="eyebrow">
        Legal
      </p><h1>Terms of Use</h1>
    </div>
  </section><section class="content-page wrap">
    <div class="notice">
      <strong>Policy update:</strong> These terms are being finalized before the official Swim BASI launch
      and will be reviewed before they become effective.
    </div><article class="prose">
      <h2>Website use</h2><p>
        Final website-use, intellectual-property, accessibility, and content-accuracy terms are in
        preparation.
      </p><h2>Products and purchases</h2><p>
        Products shown on swimbasi.com are a catalog presentation. Purchases are completed through
        Printful, and its checkout terms may also apply.
      </p><h2>Disclaimers and governing law</h2><p>
        Additional terms, including applicable disclaimers, governing law, and the effective date,
        will be included when this policy is finalized.
      </p>
    </article>
  </section></BaseLayout
>
